<% layout('/layouts/boilerplate') %>
<script>
    let tokenForMap = "<%= process.env.MAP_TOKEN %>";
    let listing = <%- JSON.stringify(listing) %> ;
</script>

<body>

    <div class="row mt-3">
        <div class="col-8 offset-3" >
            <h2><%= listing.title %></h2>
            <br>
        </div>

            <div class="card col-6 offset-3 show-card listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Listing Image">
                <br>
                <i class = "mt-0"><b>Owned by -</b><%= listing.owner.username%></i>
                <br>
                <div class="card-body">
                    <p class="card-text">

                        <%= listing.description %>
                        <br>
                        <br>
                        &#8377;<%= listing.price.toLocaleString("en-IN") %>
                        <br>
                        <br>
                        <%= listing.location %>
                        <br>
                        <br>
                        <%= listing.country %>
                        <br>

                    </p>
                </div>
            </div>
            
            <% if(currUser && listing.owner._id.equals(currUser._id)) {%>
                <div class="btns mb-5">
                    <a href = "/listings/<%= listing._id%>/edit" class = "btn btn-outline-danger col-1 offset-3">Edit</a>
                    <form method = "POST", action = "/listings/<%= listing._id%>/?_method=DELETE">
                        <button class = "btn btn-outline-dark offset-5">Delete</button>
                    </form>
                </div>
            <% } %>
    
    <div class="col-8 offset-3 mb-3">
    <hr>
    <% if(currUser) {%>
        <h4 >Leave a Review</h4>
        <form method = "post" action = "/listings/<%= listing.id%>/reviews" novalidate class = "needs-validation">
        <div class = "mb-3 mt-3">
            <label for = "rating" class = "form-label">Rating</label>
            <fieldset class="starability-basic">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="second-rate1" name="review[rating]" value="1" />
                <label for="second-rate1" title="Terrible">1 star</label>
                <input type="radio" id="second-rate2" name="review[rating]" value="2" />
                <label for="second-rate2" title="Not good">2 stars</label>
                <input type="radio" id="second-rate3" name="review[rating]" value="3" />
                <label for="second-rate3" title="Average">3 stars</label>
                <input type="radio" id="second-rate4" name="review[rating]" value="4" />
                <label for="second-rate4" title="Very good">4 stars</label>
                <input type="radio" id="second-rate5" name="review[rating]" value="5" />
                <label for="second-rate5" title="Amazing">5 stars</label>
            </fieldset>
        </div>
            <div class = "mb-3 mt-3">
                <label for = "comment" class = "form-label">Comments</label>
                <textarea name = "review[comment]" id = "comment" class = "form-control" placeholder="Type Here..." required></textarea>
                <div class = "invalid-feedback">This field is required</div>
            </div>
            <button class = "btn btn-outline-dark mb-3" >Submit</button>
        </form>
        <hr>
        <% } %>
        <% if(listing.reviews.length > 0) { %>
        <h4>All Reviews</h4>
        <hr>
        <!-- <ul>
            <% for(review of listing.reviews){ %>
                <li> <%= review.comment %>, <%= review.rating %> stars </li>
            <%  } %>
        </ul> -->

            <div class="row">
            <% for(review of listing.reviews){ %>
                <div class = "card mb-3 review-card col-12 ms-1">
                    <div class = "card-body">
                        <h5 class = "card-title"><%= review.author.username%></h5>
                        <p class="starability-result card-text mt-3 mb-3" data-rating= <%= review.rating %> >
                        </p>
                        <p class="card-text description"> <%= review.comment %> </p>
                        <!-- <p class="card-text"> <%= review.rating %> <i class="fa-solid fa-star"></i></p> -->
                    </div>
                     
                    <% if(review.author && currUser && review.author._id.equals(currUser._id)){ %>
                    <form class = "mt-3 mb-3" method = "post" action = "/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                        <button class = "btn btn-sm btn-dark">Delete</button>
                    </form>
                    <% } %>
                </div>
            <%  } %>
            </div>
        <% } %>

    </div>
    <div class = "col-6 offset-3">
            <h4 style = "color: #fe424d;">Where you'll be</h4>
            <div id = "map"></div>
    </div>
    </div>
        <script src = "/js/map.js">
    </script>
</body>
