<% layout('/layouts/boilerplate') %>

<body>
    <div class = "row mt-3">
        <div class = "col-6 offset-2">
        <h1>Login on <h1 class = "wanderLust-signup">WanderLust</h1></h1>
        <hr>
        </div>

        <div class = "col-6 offset-2">
            <form method = "POST" action = "/login" class = "needs-validation mt-5" novalidate>
                <div class = "mb-3">
                    <lable for = "username" class = "form-label">Username</lable>
                    <input name = "username" id = "username" type = "text" class = "form-control" required> 
                    <!-- <div class = "valid-feedback">Looks Good!</div> -->
                    <div class = "invalid-feedback">Username needed</div>
                </div>

                <div class = "mb-3">
                    <lable for = "password" class = "form-label">Password</lable>
                    <input name = "password" id = "password" type = "password" class = "form-control" required> 
                    <!-- <div class = "valid-feedback">Looks Good!</div> -->
                    <div class = "invalid-feedback">Password needed</div>
                </div>

                <button class = "btn btn-outline-dark">Login</button>
            </form>
        </div>
    </div>
</body>